<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CloudinaryDotNet" Version="1.28.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
		<PackageReference Include="payOS" Version="2.0.1" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>


	<ItemGroup>
		<Folder Include="Hubs\" />
		<Folder Include="Migrations\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\Application.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Adapters\OCR\tessdata\vie.traineddata">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>tessdata\vie.traineddata</TargetPath>
		</None>
		<None Update="Adapters\OCR\tessdata\eng.traineddata">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>tessdata\eng.traineddata</TargetPath>
		</None>
		<None Update="x64\*.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="x86\*.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
